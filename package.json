{
  "name": "cnc-manager",
  "productName": "CNC Manager",
  "version": "1.12.0",
  "description": "Menedżer programów CNC — tokarka Haas ST-35Y",
  "author": "CNC Manager",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.cncmanager.app",
    "productName": "CNC Manager",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "detail.html",
      "widget.html",
      "vendor/**",
      "build/icon.png"
    ],
    "win": {
      "target": ["portable", "zip"],
      "icon": "build/icon.ico",
      "artifactName": "CNC-Manager-windows.${ext}"
    },
    "portable": {
      "artifactName": "CNC-Manager.exe"
    }
  }
}
